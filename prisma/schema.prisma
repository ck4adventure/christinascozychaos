generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id         String    @id @default(cuid())
  name       String
  category   String
  frequency  String
  dayOfWeek  Int?
  dayOfMonth Int?
  emoji      String?
  flower     String
  createdAt  DateTime  @default(now())
  logs       TaskLog[]
}

model TaskLog {
  id          String   @id @default(cuid())
  taskId      String
  completedAt DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum ProjectType {
  NOVEL
  SHORT_STORY_COLLECTION
}

model Project {
  id        String      @id @default(cuid())
  title     String
  type      ProjectType @default(NOVEL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  sections  Section[]
}

model Section {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   Json
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
}

model Note {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model HourlyEntry {
  id        String       @id @default(cuid())
  message   String
  tags      String[]
  loggedAt  DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  edits     HourlyEdit[]

  @@index([loggedAt])
}

// One row per edit, holding the PREVIOUS state; the current state lives on the entry.
model HourlyEdit {
  id           String      @id @default(cuid())
  entryId      String
  entry        HourlyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  prevMessage  String
  prevTags     String[]
  prevLoggedAt DateTime
  editedAt     DateTime    @default(now())

  @@index([entryId, editedAt])
}

model HourlyQuickAdd {
  id        String   @id @default(cuid())
  label     String   @unique
  tags      String[]
  sortOrder Int
}
